    { "symbol": "SOXX", "yahooSymbol": "SOXX", "label": "芯片ETF", "role": "sector", "weight": 20, "sector": "半导体ETF", "style": "主题", "exposure": "美股" },
    { "symbol": "NVDA", "yahooSymbol": "NVDA", "label": "AI 龙头", "role": "leader", "weight": 18, "sector": "GPU", "style": "龙头", "exposure": "个股" },
    { "symbol": "AMD", "yahooSymbol": "AMD", "label": "GPU", "role": "leader", "weight": 10, "sector": "GPU", "style": "龙头", "exposure": "个股" },
