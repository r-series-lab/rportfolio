    { "symbol": "ASML", "yahooSymbol": "ASML", "label": "设备", "role": "supply_chain", "weight": 5, "sector": "设备", "style": "供应链", "exposure": "个股" },
    { "symbol": "VIX", "yahooSymbol": "^VIX", "fredSymbol": "VIXCLS", "label": "恐慌", "role": "volatility", "weight": 0, "sector": "波动率", "style": "对冲", "exposure": "观察" }
  ],
  "technicalColumns": [
    { "key": "close", "label": "收盘", "metric": "close", "format": "number", "align": "right" },
    { "key": "change1d", "label": "1D", "metric": "change_1d", "format": "percent", "tone": "signed", "align": "right" },
    { "key": "return10d", "label": "10D", "metric": "return", "period": 10, "format": "percent", "tone": "signed", "align": "right" },
    { "key": "return20d", "label": "20D", "metric": "return", "period": 20, "format": "percent", "tone": "signed", "align": "right" },
    { "key": "rsi14", "label": "RSI", "metric": "rsi", "period": 14, "format": "number1", "align": "right" },
    { "key": "ma20Gap", "label": "乖离", "metric": "ma_distance", "period": 20, "format": "percent", "tone": "signed", "align": "right" },
    { "key": "ma20_50", "label": "MA20/50", "metric": "ma_pair", "leftPeriod": 20, "rightPeriod": 50, "format": "pair0", "align": "right" },
    { "key": "volumeRatio", "label": "量比", "metric": "volume_ratio", "format": "ratio", "align": "right" }
  ],
  "dimensions": [
    {
      "key": "sector_heat",
      "label": "板块过热",
      "factor": "heat",
      "weight": 30,
      "rules": [
        { "type": "rsi_above", "symbol": "SMH", "period": 14, "threshold": 75, "points": 10, "reason": "SMH RSI {rsi}，半导体板块短线过热" },
        { "type": "distance_above_ma", "symbol": "SMH", "period": 20, "threshold": 12, "points": 6, "reason": "SMH 高于 MA20 {maDistance}，板块乖离偏大" },
        { "type": "return_above", "symbol": "SMH", "days": 10, "threshold": 12, "points": 8, "reason": "SMH 10 日涨幅超过 12%，交易拥挤升高" },
        { "type": "return_above", "symbol": "SOXX", "days": 20, "threshold": 22, "points": 8, "reason": "SOXX 20 日涨幅超过 22%，芯片链拥挤" },
        { "type": "long_bearish_volume_candle", "symbol": "SMH", "points": 12, "reason": "SMH 出现放量长阴线，板块分歧扩大" }
      ]
    },
    {
      "key": "leader_divergence",
      "label": "龙头分歧",
      "factor": "momentum",
      "weight": 30,
      "rules": [
        { "type": "high_volume_stalling", "symbol": "NVDA", "points": 12, "reason": "NVDA 高位放量滞涨，AI 主线分歧上升" },
        { "type": "distance_above_ma", "symbol": "NVDA", "period": 20, "threshold": 15, "points": 6, "reason": "NVDA 高于 MA20 {maDistance}，龙头短线拥挤" },
        { "type": "single_day_drop_volume", "symbol": "NVDA", "changeLte": -5, "volumeRatioGt": 1.5, "points": 12, "reason": "NVDA 放量大跌，龙头风险外溢" },
        { "type": "return_below_relative", "symbol": "NVDA", "other": "SMH", "days": 20, "buffer": 3, "points": 6, "reason": "NVDA 明显弱于 SMH，龙头相对强度下降" },
        { "type": "underperformed_for", "symbol": "AMD", "other": "SMH", "days": 5, "points": 6, "reason": "AMD 连续跑输 SMH，板块内部扩散变弱" }
      ]
    },
    {
      "key": "supply_chain",
      "label": "供应链强弱",
      "factor": "structure",
      "weight": 20,
      "rules": [
        { "type": "close_below_ma", "symbol": "TSM", "period": 50, "points": 7, "reason": "TSM 跌破 MA50，供应链趋势承压" },
        { "type": "close_below_ma", "symbol": "ASML", "period": 50, "points": 7, "reason": "ASML 跌破 MA50，设备链转弱" },
        { "type": "relative_strength_declined", "symbol": "TSM", "other": "SMH", "days": 5, "points": 6, "reason": "TSM 相对 SMH 连续走弱，供应链确认不足" }
      ]
    },
    {
      "key": "trend_break",
      "label": "趋势破位",
      "factor": "trend",
      "weight": 10,
      "rules": [
        { "type": "close_below_ma", "symbol": "SMH", "period": 20, "points": 5, "reason": "SMH 跌破 MA20，短线趋势降温" },
        { "type": "close_below_ma", "symbol": "SMH", "period": 50, "points": 10, "reason": "SMH 跌破 MA50，板块中期趋势承压" },
        { "type": "breadth_below_ma_ratio", "symbols": ["SMH", "SOXX", "NVDA", "AMD", "AVGO", "TSM", "ASML"], "period": 20, "threshold": 50, "points": 7, "reason": "AI 半导体样本中 {breadth} 跌破 MA20，内部宽度转弱" }
      ]
    },
    {
      "key": "volatility",
      "label": "市场波动",
      "factor": "systemic",
      "weight": 10,
      "rules": [
        { "type": "close_gte", "symbol": "VIX", "threshold": 20, "maxThreshold": 25, "points": 5, "reason": "VIX {close}，外部波动升温" },
        { "type": "close_gte", "symbol": "VIX", "threshold": 25, "points": 10, "reason": "VIX {close}，高波动压制成长股估值" }
      ]
    }
  ]
}
