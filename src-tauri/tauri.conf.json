{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rPortfolio",
  "version": "0.1.0",
  "identifier": "app.rseries.rportfolio",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1432",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rPortfolio",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
